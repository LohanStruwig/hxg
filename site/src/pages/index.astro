---
import BaseLayout from "../layouts/BaseLayout.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="HXG - Source-rights review"
  description="The Hospitality Experience Graph is temporarily unavailable while its source-rights policy is reviewed."
>
  <main id="main-content" class="maintenance-shell">
    <section class="maintenance-card" aria-labelledby="maintenance-title">
      <a class="brand" href={baseUrl} aria-label="Hospitality Experience Graph home">HXG</a>
      <p class="eyebrow">Independent research · Release review</p>
      <h1 id="maintenance-title">HXG is under<br /><em>source-rights review.</em></h1>
      <p class="summary">
        The explorer, evidence records, graph exports, poster, and LinkedIn carousel are temporarily unavailable while the project is rebuilt under a stricter source policy.
      </p>
      <div class="status" role="status">
        <span aria-hidden="true"></span>
        <p><strong>Review in progress</strong><br />A rights-aware v0.3.0 release is being prepared.</p>
      </div>
      <p class="note">HXG is independent research. No vendor sponsors, endorses, reviews, or approves this work.</p>
      <a class="repo-link" href="https://github.com/LohanStruwig/hxg">View the public repository</a>
    </section>
  </main>
</BaseLayout>

<style>
  .maintenance-shell {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: clamp(24px, 6vw, 80px) var(--page-gutter);
    background:
      radial-gradient(circle at 82% 12%, rgba(76, 196, 217, .12), transparent 34%),
      linear-gradient(135deg, #061522 0%, #081b2a 100%);
  }
  .maintenance-card {
    width: min(100%, 880px);
    padding: clamp(32px, 7vw, 88px);
    border: 1px solid var(--line);
    background: rgba(6, 21, 34, .88);
    box-shadow: 0 28px 90px rgba(0, 0, 0, .28);
  }
  .brand {
    display: inline-flex;
    min-width: 52px;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    margin-bottom: clamp(56px, 9vw, 96px);
    background: var(--ink);
    color: var(--canvas);
    font-weight: 950;
    letter-spacing: -.06em;
    text-decoration: none;
  }
  h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(3.1rem, 8vw, 7.4rem);
    line-height: .89;
    letter-spacing: -.075em;
  }
  h1 em { color: var(--cyan); font-style: normal; font-weight: inherit; }
  .summary {
    max-width: 680px;
    margin: clamp(30px, 5vw, 48px) 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.58;
  }
  .status {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: center;
    margin-top: 36px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .status > span { width: 11px; height: 11px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 0 6px rgba(245, 188, 49, .1); }
  .status p { margin: 0; color: var(--muted); line-height: 1.5; }
  .status strong { color: var(--ink); }
  .note { max-width: 660px; margin: 30px 0 0; color: var(--faint); font-size: .88rem; line-height: 1.6; }
  .repo-link {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    margin-top: 28px;
    padding: 0 18px;
    background: var(--ink);
    color: var(--canvas);
    font-weight: 850;
    text-decoration: none;
  }
  @media (max-width: 520px) {
    .maintenance-card { padding: 28px 22px 34px; }
    .brand { margin-bottom: 48px; }
    h1 { font-size: clamp(2.55rem, 12vw, 3.6rem); letter-spacing: -.065em; }
  }
</style>
