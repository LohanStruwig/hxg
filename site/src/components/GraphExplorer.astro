---
interface Props {
  claims: any[];
  sources: any[];
  entities: any[];
  relationships: any[];
}
const { claims, sources, entities, relationships } = Astro.props;
const sourceMap = Object.fromEntries(sources.map((source) => [source.id, source]));
const entityMap = Object.fromEntries(entities.map((entity) => [entity.id, entity]));
const serialize = (value: unknown) => JSON.stringify(value).replaceAll("<", "\\u003c");
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section id="graph" class="graph-section" aria-labelledby="graph-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Explore the map</p>
      <h2 id="graph-title">One graph. Three evidence states.</h2>
    </div>
    <div class="legend" aria-label="Relationship evidence legend">
      <span><i class="solid"></i> Direct</span>
      <span><i class="dashed"></i> Supported inference</span>
      <span><i class="dotted"></i> Modeled scenario</span>
    </div>
  </div>

  <div class="view-toolbar">
    <div class="view-switch" role="group" aria-label="Graph display">
      <button id="show-graph" type="button" aria-pressed="true">Interactive graph</button>
      <button id="show-list" type="button" aria-pressed="false">Relationship list</button>
    </div>
    <div class="graph-controls" role="group" aria-label="Graph zoom controls">
      <button id="zoom-out" type="button" aria-label="Zoom out">−</button>
      <button id="zoom-in" type="button" aria-label="Zoom in">+</button>
      <button id="fit-graph" type="button">Fit graph</button>
    </div>
  </div>

  <div id="graph-panel">
    <div class="graph-shell">
      <details id="graph-filters" class="filters" open>
        <summary><span>Filter the evidence</span><small id="filter-summary">All evidence shown</small></summary>
        <div class="filter-content">
          <label>
            <span>Find a node</span>
            <input id="graph-search" type="search" placeholder="Guest, casting, privacy…" autocomplete="off" />
          </label>
          <fieldset>
            <legend>Relationship type</legend>
            <label><input type="checkbox" name="edge-status" value="direct" checked /> Direct</label>
            <label><input type="checkbox" name="edge-status" value="inferred" checked /> Supported inference</label>
            <label><input type="checkbox" name="edge-status" value="scenario" checked /> Modeled scenario</label>
          </fieldset>
          <fieldset>
            <legend>Node family</legend>
            <label><input type="checkbox" name="node-family" value="outcome" checked /> Human outcomes</label>
            <label><input type="checkbox" name="node-family" value="technology" checked /> Technology</label>
            <label><input type="checkbox" name="node-family" value="stakeholder" checked /> Stakeholders</label>
            <label><input type="checkbox" name="node-family" value="value" checked /> Value pathways</label>
            <label><input type="checkbox" name="node-family" value="context" checked /> Context and limits</label>
            <label><input type="checkbox" name="node-family" value="human-experience" checked /> Center</label>
          </fieldset>
          <button id="reset-graph" class="quiet-button" type="button">Reset graph</button>
          <a class="download-link" href={`${baseUrl}data/hospitality-experience-graph.graphml`} download>Download GraphML</a>
        </div>
      </details>

      <div class="canvas-wrap">
        <div
          id="cy"
          role="img"
          aria-label="Interactive Hospitality Experience Graph. Use the relationship list for complete keyboard and assistive-technology access."
          data-ready="false"
          data-node-count="0"
          data-relationship-count="0"
        ></div>
        <p id="graph-status" class="graph-status" aria-live="polite">Loading the evidence graph…</p>
      </div>

      <aside id="evidence-drawer" class="drawer" aria-labelledby="drawer-title">
        <p class="drawer-kicker">Evidence detail</p>
        <h3 id="drawer-title">Human experience</h3>
        <p id="drawer-description">The human reason connected hospitality technology exists.</p>
        <dl id="drawer-meta">
          <div><dt>Status</dt><dd>Research synthesis</dd></div>
          <div><dt>Confidence</dt><dd>See linked claims</dd></div>
        </dl>
        <div id="drawer-claims"></div>
        <button id="view-linked-evidence" class="evidence-action" type="button" hidden>View linked evidence</button>
      </aside>
    </div>
  </div>

  <div id="list-panel" class="list-panel" hidden>
    <div class="list-tools">
      <label><span class="sr-only">Search relationships</span><input id="relationship-search" type="search" placeholder="Search relationships, entities, or claim IDs…" autocomplete="off" /></label>
      <p id="relationship-count" aria-live="polite">{relationships.length} relationships</p>
    </div>
    <div id="relationship-list" class="relationship-list">
      {relationships.map((relationship) => {
        const source = entityMap[relationship.source_entity_id];
        const target = entityMap[relationship.target_entity_id];
        const search = `${relationship.id} ${source?.canonical_name || ""} ${relationship.predicate} ${target?.canonical_name || ""} ${relationship.supporting_claim_ids.join(" ")}`.toLowerCase();
        return (
          <article data-search={search} data-relationship-id={relationship.id}>
            <span class:list={["status-mark", relationship.evidence_status]}>{relationship.evidence_status}</span>
            <h3>{source?.canonical_name} <em>{relationship.predicate}</em> {target?.canonical_name}</h3>
            <p><strong>{relationship.id}</strong> · Claims: {relationship.supporting_claim_ids.join(", ")}</p>
            <button type="button" data-inspect-relationship={relationship.id}>Inspect linked evidence</button>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script is:inline type="application/json" id="hxg-claims" set:html={serialize(claims)}></script>
<script is:inline type="application/json" id="hxg-sources" set:html={serialize(sourceMap)}></script>

<script>
  import cytoscape from "cytoscape";

  const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
  const claims = JSON.parse(document.querySelector<HTMLScriptElement>("#hxg-claims")!.textContent || "[]");
  const sources = JSON.parse(document.querySelector<HTMLScriptElement>("#hxg-sources")!.textContent || "{}");
  const claimMap = Object.fromEntries(claims.map((claim: any) => [claim.id, claim]));
  const graph = await fetch(`${base}data/hospitality-experience-graph.json`).then((response) => {
    if (!response.ok) throw new Error(`Graph request failed: ${response.status}`);
    return response.json();
  });

  const cyElement = document.querySelector<HTMLElement>("#cy")!;
  const status = document.querySelector<HTMLElement>("#graph-status")!;
  const title = document.querySelector<HTMLElement>("#drawer-title")!;
  const description = document.querySelector<HTMLElement>("#drawer-description")!;
  const meta = document.querySelector<HTMLElement>("#drawer-meta")!;
  const claimTarget = document.querySelector<HTMLElement>("#drawer-claims")!;
  const evidenceAction = document.querySelector<HTMLButtonElement>("#view-linked-evidence")!;
  const filterSummary = document.querySelector<HTMLElement>("#filter-summary")!;
  let selectedClaimIds: string[] = [];

  const cy = cytoscape({
    container: cyElement,
    elements: [...graph.elements.nodes, ...graph.elements.edges],
    minZoom: .34,
    maxZoom: 2.4,
    boxSelectionEnabled: false,
    style: [
      { selector: "node", style: { "background-color": "data(color)", label: "data(label)", color: "#f7f3ea", "font-size": "12px", "font-weight": 700, "text-wrap": "wrap", "text-max-width": "100px", "text-valign": "bottom", "text-margin-y": 10, width: "34px", height: "34px", "border-width": "3px", "border-color": "#061522", "overlay-opacity": 0 } },
      { selector: "node[entity_type = 'outcome']", style: { width: "54px", height: "54px", "font-size": "14px" } },
      { selector: "node[id = 'ENT-HUMAN-EXPERIENCE']", style: { width: "84px", height: "84px", "font-size": "16px", "text-max-width": "130px", "border-width": "5px" } },
      { selector: "edge", style: { width: 1.8, "line-color": "#5c7383", "target-arrow-color": "#5c7383", "target-arrow-shape": "triangle", "curve-style": "bezier", "arrow-scale": .7, opacity: .72, label: "", color: "#c5d1d8", "font-size": "9px", "text-rotation": "autorotate", "text-background-color": "#061522", "text-background-opacity": .92, "text-background-padding": "3px" } },
      { selector: "edge.labels-visible", style: { label: "data(predicate)" } },
      { selector: "edge[evidence_status = 'inferred']", style: { "line-style": "dashed" } },
      { selector: "edge[evidence_status = 'scenario']", style: { "line-style": "dotted", "line-color": "#f5bc31", "target-arrow-color": "#f5bc31" } },
      { selector: ".faded", style: { opacity: .09 } },
      { selector: ".matched", style: { "border-color": "#f5bc31", "border-width": "6px" } },
      { selector: "node:selected", style: { "border-color": "#f7f3ea", "border-width": "6px", opacity: 1 } },
      { selector: "edge:selected", style: { label: "data(predicate)", "line-color": "#f7f3ea", "target-arrow-color": "#f7f3ea", opacity: 1, width: 3 } }
    ],
    layout: { name: "preset", fit: true, padding: 68 }
  });

  const plural = (count: number, singular: string) => `${count} ${singular}${count === 1 ? "" : "s"}`;
  const shownNodes = () => cy.nodes().filter((node) => node.style("display") !== "none");
  const shownEdges = () => cy.edges().filter((edge) => edge.style("display") !== "none");
  const setStatus = (message: string, nodeCount = shownNodes().length, edgeCount = shownEdges().length) => {
    status.textContent = `${message} · ${plural(nodeCount, "node")} · ${plural(edgeCount, "relationship")}`;
    cyElement.dataset.nodeCount = String(nodeCount);
    cyElement.dataset.relationshipCount = String(edgeCount);
  };

  function appendMeta(label: string, value: string) {
    const row = document.createElement("div");
    const term = document.createElement("dt");
    const detail = document.createElement("dd");
    term.textContent = label;
    detail.textContent = value;
    row.append(term, detail);
    meta.append(row);
  }

  function safeSourceLink(sourceId: string): HTMLElement {
    const source = sources[sourceId];
    if (!source) {
      const text = document.createElement("span");
      text.textContent = sourceId;
      return text;
    }
    const link = document.createElement("a");
    link.textContent = sourceId;
    try {
      const url = new URL(source.url);
      if (url.protocol === "http:" || url.protocol === "https:") {
        link.href = url.href;
        link.target = "_blank";
        link.rel = "noreferrer";
      }
    } catch {
      link.removeAttribute("href");
    }
    return link;
  }

  function renderClaims(ids: string[]) {
    claimTarget.replaceChildren();
    ids.map((id) => claimMap[id]).filter(Boolean).forEach((claim: any) => {
      const card = document.createElement("article");
      card.className = "drawer-claim";
      const classification = document.createElement("span");
      classification.textContent = claim.classification;
      const claimId = document.createElement("strong");
      claimId.textContent = claim.id;
      const copy = document.createElement("p");
      copy.textContent = claim.text;
      const sourceLinks = document.createElement("small");
      claim.evidence_ids.forEach((sourceId: string, index: number) => {
        if (index) sourceLinks.append(document.createTextNode(" · "));
        sourceLinks.append(safeSourceLink(sourceId));
      });
      card.append(classification, claimId, copy, sourceLinks);
      claimTarget.append(card);
    });
    selectedClaimIds = ids;
    evidenceAction.hidden = ids.length === 0;
  }

  function renderNode(data: any) {
    const ids = String(data.evidence_ids || "").split("|").filter(Boolean);
    title.textContent = data.label;
    description.textContent = data.description;
    meta.replaceChildren();
    appendMeta("Family", data.entity_type);
    appendMeta("Claims", ids.length ? String(ids.length) : "See connected edges");
    renderClaims(ids);
    setStatus(`${data.label} selected · ${plural(ids.length, "linked claim")}`);
  }

  function renderEdge(edge: cytoscape.EdgeSingular) {
    const data = edge.data();
    const ids = String(data.supporting_claim_ids || "").split("|").filter(Boolean);
    title.textContent = `${edge.source().data("label")} → ${edge.target().data("label")}`;
    description.textContent = data.predicate;
    meta.replaceChildren();
    appendMeta("Status", data.evidence_status);
    appendMeta("Confidence", `${Math.round(Number(data.confidence) * 100)}%`);
    renderClaims(ids);
    setStatus(`${data.evidence_status} relationship selected · ${plural(ids.length, "supporting claim")}`);
  }

  cy.on("tap", "node", (event) => renderNode(event.target.data()));
  cy.on("tap", "edge", (event) => renderEdge(event.target));

  function applySearch() {
    const query = document.querySelector<HTMLInputElement>("#graph-search")!.value.trim().toLowerCase();
    cy.nodes().removeClass("matched faded");
    cy.edges().removeClass("faded");
    if (!query) {
      setStatus("Search cleared");
      return;
    }
    const candidates = shownNodes();
    const matches = candidates.filter((node) => `${node.data("label")} ${node.data("description")}`.toLowerCase().includes(query));
    shownNodes().addClass("faded");
    shownEdges().addClass("faded");
    matches.removeClass("faded").addClass("matched");
    const connected = matches.connectedEdges().filter((edge) => edge.style("display") !== "none");
    connected.removeClass("faded");
    connected.connectedNodes().removeClass("faded");
    if (matches.length) {
      cy.animate({ fit: { eles: matches.union(connected), padding: 90 }, duration: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 220 });
      setStatus(`Search “${query}”`, matches.length, connected.length);
    } else {
      setStatus(`No results for “${query}”`, 0, 0);
    }
  }

  function applyFilters() {
    const edgeStatuses = new Set(Array.from(document.querySelectorAll<HTMLInputElement>("input[name='edge-status']:checked")).map((input) => input.value));
    const families = new Set(Array.from(document.querySelectorAll<HTMLInputElement>("input[name='node-family']:checked")).map((input) => input.value));
    cy.batch(() => {
      cy.nodes().forEach((node) => { node.style("display", families.has(node.data("entity_type")) ? "element" : "none"); });
      cy.edges().forEach((edge) => { edge.style("display", edgeStatuses.has(edge.data("evidence_status")) && edge.source().style("display") !== "none" && edge.target().style("display") !== "none" ? "element" : "none"); });
    });
    filterSummary.textContent = `${shownNodes().length} nodes · ${shownEdges().length} relationships`;
    document.querySelector<HTMLInputElement>("#graph-search")!.value = "";
    cy.elements().removeClass("matched faded");
    setStatus("Filters updated");
  }

  document.querySelectorAll<HTMLInputElement>("input[name='edge-status'], input[name='node-family']").forEach((input) => input.addEventListener("change", applyFilters));
  document.querySelector<HTMLInputElement>("#graph-search")!.addEventListener("input", applySearch);

  function resetGraph() {
    document.querySelector<HTMLInputElement>("#graph-search")!.value = "";
    document.querySelectorAll<HTMLInputElement>("#graph-filters input[type='checkbox']").forEach((input) => input.checked = true);
    cy.elements().removeClass("matched faded").style("display", "element").unselect();
    filterSummary.textContent = "All evidence shown";
    cy.fit(undefined, 68);
    setStatus("Graph reset");
  }

  document.querySelector<HTMLButtonElement>("#reset-graph")!.addEventListener("click", resetGraph);
  document.querySelector<HTMLButtonElement>("#zoom-in")!.addEventListener("click", () => {
    cy.zoom({ level: Math.min(cy.zoom() * 1.22, cy.maxZoom()), renderedPosition: { x: cy.width() / 2, y: cy.height() / 2 } });
    setStatus("Zoomed in");
  });
  document.querySelector<HTMLButtonElement>("#zoom-out")!.addEventListener("click", () => {
    cy.zoom({ level: Math.max(cy.zoom() / 1.22, cy.minZoom()), renderedPosition: { x: cy.width() / 2, y: cy.height() / 2 } });
    setStatus("Zoomed out");
  });
  document.querySelector<HTMLButtonElement>("#fit-graph")!.addEventListener("click", () => {
    cy.fit(shownNodes().union(shownEdges()), 68);
    setStatus("Graph fitted to view");
  });

  const graphPanel = document.querySelector<HTMLElement>("#graph-panel")!;
  const listPanel = document.querySelector<HTMLElement>("#list-panel")!;
  const showGraph = document.querySelector<HTMLButtonElement>("#show-graph")!;
  const showList = document.querySelector<HTMLButtonElement>("#show-list")!;
  function setView(view: "graph" | "list") {
    const graphVisible = view === "graph";
    graphPanel.hidden = !graphVisible;
    listPanel.hidden = graphVisible;
    showGraph.setAttribute("aria-pressed", String(graphVisible));
    showList.setAttribute("aria-pressed", String(!graphVisible));
    document.querySelector<HTMLElement>(".graph-controls")!.hidden = !graphVisible;
    if (graphVisible) {
      requestAnimationFrame(() => { cy.resize(); cy.fit(shownNodes().union(shownEdges()), 68); });
      setStatus("Interactive graph view");
    } else {
      document.querySelector<HTMLInputElement>("#relationship-search")!.focus();
    }
  }
  showGraph.addEventListener("click", () => setView("graph"));
  showList.addEventListener("click", () => setView("list"));

  const relationshipItems = Array.from(document.querySelectorAll<HTMLElement>("#relationship-list article"));
  const relationshipCount = document.querySelector<HTMLElement>("#relationship-count")!;
  document.querySelector<HTMLInputElement>("#relationship-search")!.addEventListener("input", (event) => {
    const query = (event.target as HTMLInputElement).value.trim().toLowerCase();
    let visible = 0;
    relationshipItems.forEach((item) => {
      item.hidden = !!query && !(item.dataset.search || "").includes(query);
      if (!item.hidden) visible += 1;
    });
    relationshipCount.textContent = plural(visible, "relationship");
  });

  document.querySelectorAll<HTMLButtonElement>("[data-inspect-relationship]").forEach((button) => {
    button.addEventListener("click", () => {
      const edge = cy.getElementById(button.dataset.inspectRelationship || "");
      if (!edge.empty()) {
        setView("graph");
        edge.select();
        renderEdge(edge as cytoscape.EdgeSingular);
        requestAnimationFrame(() => {
          const target = mobile.matches ? document.querySelector("#evidence-drawer") : document.querySelector(".section-heading");
          target?.scrollIntoView({ block: "start" });
        });
      }
    });
  });

  evidenceAction.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("hxg:view-evidence", { detail: { claimIds: selectedClaimIds } }));
  });

  const mobile = window.matchMedia("(max-width: 760px)");
  const filters = document.querySelector<HTMLDetailsElement>("#graph-filters")!;
  const applyResponsiveGraph = () => {
    filters.open = !mobile.matches;
    cy.edges().toggleClass("labels-visible", !mobile.matches);
  };
  applyResponsiveGraph();
  mobile.addEventListener("change", applyResponsiveGraph);

  let resizeTimer = 0;
  const observer = new ResizeObserver(() => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      cy.resize();
      if (!graphPanel.hidden) cy.fit(shownNodes().union(shownEdges()), 68);
    }, 140);
  });
  observer.observe(cyElement);

  requestAnimationFrame(() => {
    cy.resize();
    cyElement.dataset.ready = "true";
    cyElement.dataset.nodeCount = String(cy.nodes().length);
    cyElement.dataset.relationshipCount = String(cy.edges().length);
    filterSummary.textContent = "All evidence shown";
    cy.fit(undefined, 68);
    setStatus("Graph ready", cy.nodes().length, cy.edges().length);
  });
</script>

<style>
  .graph-section { max-width: var(--max); margin: 0 auto; padding: 110px var(--page-gutter) 70px; scroll-margin-top: var(--header-offset); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 28px; scroll-margin-top: calc(var(--header-height) + 24px); }
  h2 { margin: 0; max-width: 720px; font-size: clamp(2.2rem,4vw,4.4rem); line-height: .98; letter-spacing: -.055em; text-wrap: balance; }
  .legend { display: flex; flex-wrap: wrap; gap: 16px; color: var(--muted); font-size: .8rem; }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .legend i { width: 30px; height: 0; border-top: 2px solid var(--muted); }
  .legend .dashed { border-top-style: dashed; }
  .legend .dotted { border-top: 3px dotted var(--amber); }
  .view-toolbar { display: flex; justify-content: space-between; gap: 16px; align-items: center; padding: 10px; border: 1px solid var(--line); border-bottom: 0; background: #081a28; scroll-margin-top: calc(var(--header-height) + 16px); }
  .view-switch, .graph-controls { display: flex; gap: 6px; }
  .view-switch button, .graph-controls button { min-height: 44px; border: 1px solid var(--line); background: transparent; color: var(--muted); padding: 0 14px; cursor: pointer; }
  .view-switch button[aria-pressed="true"] { background: var(--ink); color: var(--canvas); border-color: var(--ink); font-weight: 800; }
  .graph-controls button { min-width: 44px; color: var(--ink); }
  .graph-shell { min-height: 720px; display: grid; grid-template-columns: 232px minmax(0,1fr) 310px; border: 1px solid var(--line); background: var(--surface); box-shadow: 0 22px 80px rgba(0,0,0,.26); }
  .filters, .drawer { background: #081a28; }
  .filters { border-right: 1px solid var(--line); }
  .filters summary { display: none; }
  .filter-content, .drawer { padding: 24px; }
  .drawer { border-left: 1px solid var(--line); overflow: auto; max-height: 720px; scroll-margin-top: calc(var(--header-height) + 16px); }
  .drawer h3 { margin: 0 0 16px; font-size: 1.05rem; overflow-wrap: anywhere; }
  .filters label > span, legend { display: block; color: var(--muted); font-size: .72rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; margin-bottom: 9px; }
  input[type="search"] { width: 100%; min-height: 44px; border: 1px solid var(--line); background: var(--canvas); color: var(--ink); padding: 0 12px; border-radius: 6px; }
  fieldset { border: 0; padding: 0; margin: 28px 0; }
  fieldset label { min-height: 32px; display: flex; gap: 9px; align-items: center; color: var(--muted); font-size: .86rem; margin: 5px 0; }
  input[type="checkbox"] { accent-color: var(--cyan); width: 18px; height: 18px; }
  .quiet-button, .download-link, .evidence-action { width: 100%; min-height: 44px; display: grid; place-items: center; border: 1px solid var(--line); background: transparent; color: var(--ink); text-decoration: none; cursor: pointer; }
  .download-link { margin-top: 10px; background: var(--ink); color: var(--canvas); font-weight: 800; }
  .canvas-wrap { position: relative; min-width: 0; min-height: 720px; }
  #cy { position: absolute; inset: 0 0 48px; touch-action: none; }
  .graph-status { position: absolute; inset: auto 0 0; min-height: 48px; margin: 0; padding: 13px 18px; border-top: 1px solid var(--line); color: var(--muted); font-size: .8rem; background: #081a28; }
  .drawer-kicker { margin: 0 0 10px; color: var(--amber); font-size: .7rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .drawer > p:not(.drawer-kicker) { color: var(--muted); line-height: 1.55; }
  dl { margin: 24px 0; border-block: 1px solid var(--line); }
  :global(#drawer-meta > div) { display: block; padding: 12px 0; }
  :global(#drawer-meta dt) { color: var(--faint); font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  :global(#drawer-meta dd) { margin: 5px 0 0; overflow-wrap: anywhere; }
  :global(.drawer-claim) { padding: 16px 0; border-top: 1px solid var(--line); }
  :global(.drawer-claim span) { color: var(--cyan); font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; }
  :global(.drawer-claim strong) { display: block; margin-top: 4px; font-size: .82rem; overflow-wrap: anywhere; }
  :global(.drawer-claim p) { color: var(--muted); font-size: .86rem; line-height: 1.5; }
  :global(.drawer-claim small) { display: flex; flex-wrap: wrap; gap: 4px; color: var(--cyan); }
  .evidence-action { margin-top: 18px; background: var(--ink); color: var(--canvas); font-weight: 800; }
  .list-panel { border: 1px solid var(--line); background: #081a28; }
  .list-tools { display: grid; grid-template-columns: minmax(240px, 1fr) auto; align-items: center; gap: 16px; padding: 18px; border-bottom: 1px solid var(--line); }
