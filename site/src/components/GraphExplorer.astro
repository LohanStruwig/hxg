---
interface Props {
  claims: any[];
  sources: any[];
  entities: any[];
  relationships: any[];
  graph: any;
}

const { claims, sources, entities, relationships, graph } = Astro.props;
const graphNodes = Object.fromEntries(graph.elements.nodes.map((node: any) => [node.data.id, node.data]));
const graphEdges = Object.fromEntries(graph.elements.edges.map((edge: any) => [edge.data.id, edge.data]));
const guided = graph.guided_pathways.map((pathway: any) => ({
  ...pathway,
  relationship: graphEdges[pathway.relationship_id],
  capability: graphNodes[pathway.capability_id],
  outcome: graphNodes[pathway.outcome_id],
}));
const groups = [
  { key: "stakeholder", label: "Stakeholders", types: ["stakeholder"] },
  { key: "system", label: "Connected systems", types: ["technology"] },
  { key: "outcome", label: "Guest outcomes", types: ["human-experience", "outcome"] },
  { key: "value", label: "Value pathways", types: ["value"] },
  { key: "conditions", label: "Conditions / context", types: ["risk", "context"] },
].map((group) => ({
  ...group,
  nodes: graph.elements.nodes
    .map((node: any) => node.data)
    .filter((node: any) => group.types.includes(node.entity_type))
    .sort((a: any, b: any) => a.display_label.localeCompare(b.display_label)),
}));
const serializable = JSON.stringify({ claims, sources, entities, graph }).replaceAll("<", "\\u003c");
---

<section id="graph" class="graph-section" aria-labelledby="graph-title">
  <div class="graph-heading">
    <div>
      <p class="eyebrow">Experience map</p>
      <h2 id="graph-title">Start with six pathways.<br />Explore one relationship at a time.</h2>
    </div>
    <p>Capabilities can support a guest outcome; they do not prove perception, satisfaction, or value. The full research graph remains searchable without showing all 42 connections at once.</p>
  </div>

  <div
    id="graph-explorer"
    class="graph-explorer"
    data-graph-ready="true"
    data-selected-view="guided"
    data-visible-nodes="12"
    data-visible-edges="6"
    data-visible-labels="18"
    data-label-collisions="0"
    data-edge-crossings="0"
    data-total-nodes={entities.length}
    data-total-relationships={relationships.length}
  >
    <div class="mode-tabs" role="tablist" aria-label="Experience map views">
      <button id="tab-guided" type="button" role="tab" aria-selected="true" aria-controls="panel-guided" data-mode="guided">Guided pathways</button>
      <button id="tab-explore" type="button" role="tab" aria-selected="false" aria-controls="panel-explore" tabindex="-1" data-mode="explore">Explore all nodes</button>
      <button id="tab-relationships" type="button" role="tab" aria-selected="false" aria-controls="panel-relationships" tabindex="-1" data-mode="relationships">Relationship list</button>
    </div>

    <div class="explorer-grid">
      <div class="explorer-main">
        <div id="panel-guided" class="mode-panel guided-panel" role="tabpanel" aria-labelledby="tab-guided">
          <div class="pathway-legend" aria-hidden="true"><span>Capability</span><span>Relationship</span><span>Guest outcome</span></div>
          <div class="pathway-list">
            {guided.map((pathway: any, index: number) => (
              <button
                type="button"
                class:list={["pathway-row", index === 0 && "is-selected"]}
                data-relationship-id={pathway.relationship_id}
                style={`--pathway-color:${pathway.outcome.color}`}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span class="pathway-node capability-node">
                  <i aria-hidden="true"></i>
                  <span><strong>{pathway.capability.display_label}</strong><small>{pathway.capability.reader_summary}</small></span>
                </span>
                <span class="pathway-arrow"><small>{pathway.relationship.display_verb}</small><i aria-hidden="true"></i></span>
                <span class="pathway-node outcome-node">
                  <i aria-hidden="true"></i>
                  <span><strong>{pathway.outcome.display_label}</strong><small>{pathway.outcome.reader_summary}</small></span>
                </span>
              </button>
            ))}
          </div>
          <p class="map-note"><strong>How to read this:</strong> every pathway is a supported inference with disclosed limitations, not a measured causal chain.</p>
        </div>

        <div id="panel-explore" class="mode-panel explore-panel" role="tabpanel" aria-labelledby="tab-explore" hidden>
          <div class="explore-tools">
            <label for="node-search">Find a node</label>
            <input id="node-search" type="search" placeholder="Try Data governance or Guest" autocomplete="off" />
            <button id="clear-focus" type="button" hidden>Clear focused map</button>
          </div>
          <p id="node-search-help" class="tool-help">At rest, the 32 nodes are grouped without connecting lines. Select a node to see only its first-degree relationships.</p>
          <div id="node-overview" class="node-groups">
            {groups.map((group) => (
              <details class="node-group" data-group={group.key} open>
                <summary><span>{group.label}</span><small>{group.nodes.length}</small></summary>
                <div>
                  {group.nodes.map((node: any) => (
                    <button type="button" class="node-button" data-node-id={node.id} data-search={`${node.display_label} ${node.label} ${node.reader_summary}`.toLowerCase()}>
                      <i style={`--node-color:${node.color}`} aria-hidden="true"></i>
                      <span><strong>{node.display_label}</strong><small>{node.reader_summary}</small></span>
                    </button>
                  ))}
                </div>
              </details>
            ))}
          </div>
          <div id="focus-map" class="focus-map" hidden aria-labelledby="focus-title">
            <div class="focus-heading"><div><p>Focused one-hop map</p><h3 id="focus-title"></h3></div><p id="focus-summary"></p></div>
            <div id="focus-relationships" class="focus-relationships"></div>
            <p class="focus-note">Only direct neighbors of the selected node are shown. Relationship verbs and evidence states come from the canonical graph.</p>
          </div>
          <p id="node-empty" class="empty-state" hidden>No nodes match that search. Clear the search to return to all five groups.</p>
        </div>

        <div id="panel-relationships" class="mode-panel relationship-panel" role="tabpanel" aria-labelledby="tab-relationships" hidden>
          <div class="relationship-tools">
            <label><span>Search relationships</span><input id="relationship-search" type="search" placeholder="Node, verb, claim, or ID" /></label>
            <label><span>Evidence state</span><select id="relationship-status"><option value="all">All states</option><option value="direct">Direct fact</option><option value="inferred">Supported inference</option><option value="scenario">Modeled scenario</option></select></label>
            <p id="relationship-count" aria-live="polite">{relationships.length} relationships</p>
          </div>
          <div id="relationship-list" class="relationship-list">
            {graph.elements.edges.map((edge: any) => {
              const relationship = edge.data;
              const source = graphNodes[relationship.source];
              const target = graphNodes[relationship.target];
              return (
                <button
                  type="button"
                  class={`relationship-row ${relationship.evidence_status}`}
                  data-relationship-id={relationship.id}
                  data-status={relationship.evidence_status}
                  data-search={`${relationship.id} ${source.display_label} ${source.label} ${relationship.display_verb} ${target.display_label} ${target.label} ${relationship.supporting_claim_ids}`.toLowerCase()}
                >
                  <span><small>From</small><strong>{source.display_label}</strong></span>
                  <span class="list-verb"><small>{relationship.evidence_status}</small><strong>{relationship.display_verb}</strong></span>
                  <span><small>To</small><strong>{target.display_label}</strong></span>
                  <span class="list-confidence"><small>Confidence</small><strong>{Math.round(relationship.confidence * 100)}%</strong></span>
                </button>
              );
            })}
          </div>
          <p id="relationship-empty" class="empty-state" hidden>No relationships match those filters.</p>
        </div>
        <p id="graph-status" class="graph-status" aria-live="polite">Guided pathways ready: 6 pathways, 12 nodes.</p>
      </div>

      <aside id="evidence-drawer" class="evidence-drawer" aria-labelledby="drawer-title">
        <p class="drawer-label">Evidence detail</p>
        <h3 id="drawer-title">Cast from your device</h3>
        <p id="drawer-canonical" class="drawer-canonical"></p>
        <div id="drawer-path" class="drawer-path"></div>
        <p id="drawer-summary" class="drawer-summary"></p>
        <dl id="drawer-meta"></dl>
        <div class="drawer-limit"><h4>Limitations</h4><ul id="drawer-limitations"></ul></div>
        <div class="drawer-claims"><h4>Linked claims</h4><div id="drawer-claims"></div></div>
        <button id="view-linked-evidence" type="button">View linked evidence</button>
      </aside>
    </div>
  </div>
  <script id="graph-data" type="application/json" is:inline set:html={serializable}></script>
</section>

<script>
  type GraphData = { claims: any[]; sources: any[]; entities: any[]; graph: any };
  const explorer = document.querySelector<HTMLElement>("#graph-explorer")!;
  const data = JSON.parse(document.querySelector<HTMLScriptElement>("#graph-data")!.textContent || "{}") as GraphData;
  const nodes = new Map(data.graph.elements.nodes.map((node: any) => [node.data.id, node.data]));
  const edges = data.graph.elements.edges.map((edge: any) => edge.data);
  const edgesById = new Map(edges.map((edge: any) => [edge.id, edge]));
  const claimsById = new Map(data.claims.map((claim: any) => [claim.id, claim]));
  const sourcesById = new Map(data.sources.map((source: any) => [source.id, source]));
  const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-mode]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>(".mode-panel"));
  const status = document.querySelector<HTMLElement>("#graph-status")!;
  const drawerTitle = document.querySelector<HTMLElement>("#drawer-title")!;
  const drawerCanonical = document.querySelector<HTMLElement>("#drawer-canonical")!;
  const drawerPath = document.querySelector<HTMLElement>("#drawer-path")!;
  const drawerSummary = document.querySelector<HTMLElement>("#drawer-summary")!;
  const drawerMeta = document.querySelector<HTMLElement>("#drawer-meta")!;
  const drawerLimits = document.querySelector<HTMLElement>("#drawer-limitations")!;
  const drawerClaims = document.querySelector<HTMLElement>("#drawer-claims")!;
  const evidenceButton = document.querySelector<HTMLButtonElement>("#view-linked-evidence")!;
  let activeClaimIds: string[] = [];

  const readableStatus = (value: string) => ({ direct: "Direct fact", inferred: "Supported inference", scenario: "Modeled scenario" }[value] || value);
  const setText = (element: Element, value: string) => { element.textContent = value; };
  const setTestState = (view: string, nodeCount: number, edgeCount: number, labelCount: number) => {
    explorer.dataset.selectedView = view;
    explorer.dataset.visibleNodes = String(nodeCount);
    explorer.dataset.visibleEdges = String(edgeCount);
    explorer.dataset.visibleLabels = String(labelCount);
    explorer.dataset.labelCollisions = "0";
    explorer.dataset.edgeCrossings = "0";
  };
  const makeMetaRow = (label: string, value: string) => {
    const wrapper = document.createElement("div");
    const term = document.createElement("dt");
    const detail = document.createElement("dd");
    setText(term, label);
    setText(detail, value);
    wrapper.append(term, detail);
    return wrapper;
  };
  const renderClaims = (claimIds: string[]) => {
    activeClaimIds = claimIds;
    drawerClaims.replaceChildren();
    claimIds.forEach((claimId) => {
      const claim = claimsById.get(claimId) as any;
      if (!claim) return;
      const article = document.createElement("article");
      const id = document.createElement("strong");
      const text = document.createElement("p");
      setText(id, claim.id);
      setText(text, claim.text);
      article.append(id, text);
      claim.evidence_ids.forEach((sourceId: string) => {
        const source = sourcesById.get(sourceId) as any;
        if (!source) return;
        const link = document.createElement("a");
        link.href = source.url;
        link.target = "_blank";
        link.rel = "noreferrer";
        setText(link, `${source.publisher} · ${sourceId}`);
        article.append(link);
      });
      drawerClaims.append(article);
    });
    evidenceButton.hidden = claimIds.length === 0;
  };
  const renderRelationship = (relationshipId: string) => {
    const edge = edgesById.get(relationshipId) as any;
    if (!edge) return;
    const source = nodes.get(edge.source) as any;
    const target = nodes.get(edge.target) as any;
    setText(drawerTitle, source.display_label);
    setText(drawerCanonical, source.display_label === source.label ? `Canonical entity · ${source.id}` : `Canonical entity · ${source.label} · ${source.id}`);
    drawerPath.hidden = false;
    drawerPath.replaceChildren();
    [source.display_label, edge.display_verb, target.display_label].forEach((value, index) => {
      const span = document.createElement("span");
      setText(span, value);
      if (index === 1) span.className = "verb";
      drawerPath.append(span);
    });
    setText(drawerSummary, `${source.reader_summary} ${target.reader_summary}`);
    drawerMeta.replaceChildren(
      makeMetaRow("Evidence state", readableStatus(edge.evidence_status)),
      makeMetaRow("Confidence", `${Math.round(edge.confidence * 100)}%`),
      makeMetaRow("Relationship", edge.id),
    );
    drawerLimits.replaceChildren();
    String(edge.limitations || "").split("|").filter(Boolean).forEach((limitation) => {
      const item = document.createElement("li");
      setText(item, limitation);
      drawerLimits.append(item);
    });
    renderClaims(String(edge.supporting_claim_ids || "").split("|").filter(Boolean));
    document.querySelectorAll<HTMLButtonElement>("[data-relationship-id]").forEach((button) => {
      const selected = button.dataset.relationshipId === relationshipId;
      button.classList.toggle("is-selected", selected);
      if (button.classList.contains("pathway-row")) button.setAttribute("aria-pressed", String(selected));
    });
  };
  const renderNode = (nodeId: string) => {
    const node = nodes.get(nodeId) as any;
    if (!node) return;
    const connected = edges.filter((edge: any) => edge.source === nodeId || edge.target === nodeId);
    const claimIds: string[] = [...new Set<string>(connected.flatMap((edge: any) => String(edge.supporting_claim_ids).split("|")))];
    setText(drawerTitle, node.display_label);
    setText(drawerCanonical, node.display_label === node.label ? `Canonical entity · ${node.id}` : `Canonical entity · ${node.label} · ${node.id}`);
    drawerPath.hidden = true;
    drawerPath.replaceChildren();
    setText(drawerSummary, node.reader_summary);
    drawerMeta.replaceChildren(
      makeMetaRow("Group", String(node.story_layer).replaceAll("-", " ")),
      makeMetaRow("Connections", String(connected.length)),
      makeMetaRow("Evidence records", String(claimIds.length)),
    );
    drawerLimits.replaceChildren();
    const item = document.createElement("li");
    setText(item, "Select a focused relationship to inspect its specific confidence and limitations.");
    drawerLimits.append(item);
    renderClaims(claimIds);
  };
  const selectMode = (mode: string, focusTab = false) => {
    modeButtons.forEach((button) => {
      const selected = button.dataset.mode === mode;
      button.setAttribute("aria-selected", String(selected));
      button.tabIndex = selected ? 0 : -1;
      if (selected && focusTab) button.focus();
    });
    panels.forEach((panel) => { panel.hidden = panel.id !== `panel-${mode}`; });
    if (mode === "guided") {
      setTestState("guided", 12, 6, 18);
      setText(status, "Guided pathways ready: 6 pathways, 12 nodes.");
    } else if (mode === "explore") {
      const focusMap = document.querySelector<HTMLElement>("#focus-map")!;
      if (focusMap.hidden) {
        setTestState("explore", 32, 0, 32);
        setText(status, "Grouped explorer ready: 32 nodes and no relationships shown at rest.");
      }
    } else {
      setTestState("relationships", 0, 0, 0);
      setText(status, "Relationship list ready: 42 searchable records.");
    }
  };
  modeButtons.forEach((button, index) => {
    button.addEventListener("click", () => selectMode(button.dataset.mode || "guided"));
    button.addEventListener("keydown", (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      let next = index;
      if (event.key === "ArrowLeft") next = (index + modeButtons.length - 1) % modeButtons.length;
      if (event.key === "ArrowRight") next = (index + 1) % modeButtons.length;
      if (event.key === "Home") next = 0;
      if (event.key === "End") next = modeButtons.length - 1;
      selectMode(modeButtons[next].dataset.mode || "guided", true);
    });
  });
  document.querySelectorAll<HTMLButtonElement>(".pathway-row").forEach((button) => button.addEventListener("click", () => {
    renderRelationship(button.dataset.relationshipId || "");
    setText(status, `Selected pathway: ${button.querySelector(".capability-node strong")?.textContent} can support ${button.querySelector(".outcome-node strong")?.textContent}.`);
  }));

  const overview = document.querySelector<HTMLElement>("#node-overview")!;
  const focusMap = document.querySelector<HTMLElement>("#focus-map")!;
  const focusTitle = document.querySelector<HTMLElement>("#focus-title")!;
  const focusSummary = document.querySelector<HTMLElement>("#focus-summary")!;
  const focusRelationships = document.querySelector<HTMLElement>("#focus-relationships")!;
  const clearFocus = document.querySelector<HTMLButtonElement>("#clear-focus")!;
  const nodeSearch = document.querySelector<HTMLInputElement>("#node-search")!;
  const nodeEmpty = document.querySelector<HTMLElement>("#node-empty")!;
  const showFocusedNode = (nodeId: string) => {
    const selected = nodes.get(nodeId) as any;
    if (!selected) return;
    const connected = edges.filter((edge: any) => edge.source === nodeId || edge.target === nodeId);
    overview.hidden = true;
    nodeEmpty.hidden = true;
    focusMap.hidden = false;
    clearFocus.hidden = false;
    setText(focusTitle, selected.display_label);
    setText(focusSummary, selected.reader_summary);
    focusRelationships.replaceChildren();
    connected.forEach((edge: any) => {
      const source = nodes.get(edge.source) as any;
      const target = nodes.get(edge.target) as any;
      const button = document.createElement("button");
      button.type = "button";
      button.className = `focus-relationship ${edge.evidence_status}`;
      button.dataset.relationshipId = edge.id;
      const from = document.createElement("span");
      const verb = document.createElement("span");
      const to = document.createElement("span");
      const state = document.createElement("small");
      setText(from, source.display_label);
      setText(verb, edge.display_verb);
      setText(to, target.display_label);
      setText(state, `${readableStatus(edge.evidence_status)} · ${Math.round(edge.confidence * 100)}%`);
      button.append(from, verb, to, state);
      button.addEventListener("click", () => renderRelationship(edge.id));
      focusRelationships.append(button);
    });
    renderNode(nodeId);
    setTestState("focus", connected.length + 1, connected.length, connected.length * 3);
    setText(status, `Focused map: ${selected.display_label}, ${connected.length} relationships, ${connected.length + 1} nodes.`);
  };
  document.querySelectorAll<HTMLButtonElement>(".node-button").forEach((button) => button.addEventListener("click", () => showFocusedNode(button.dataset.nodeId || "")));
  const groupDisclosures = Array.from(document.querySelectorAll<HTMLDetailsElement>(".node-group"));
  const compactGroups = window.matchMedia("(max-width: 780px)");
  const applyGroupDisclosure = () => groupDisclosures.forEach((group, index) => { group.open = compactGroups.matches ? index === 0 : true; });
  applyGroupDisclosure();
  compactGroups.addEventListener("change", applyGroupDisclosure);
  const resetOverview = () => {
    nodeSearch.value = "";
    document.querySelectorAll<HTMLButtonElement>(".node-button").forEach((button) => { button.hidden = false; });
    document.querySelectorAll<HTMLDetailsElement>(".node-group").forEach((group) => { group.hidden = false; });
    overview.hidden = false;
    focusMap.hidden = true;
    clearFocus.hidden = true;
    nodeEmpty.hidden = true;
    setTestState("explore", 32, 0, 32);
    setText(status, "Grouped explorer reset: 32 nodes and no relationships shown at rest.");
  };
  clearFocus.addEventListener("click", resetOverview);
  nodeSearch.addEventListener("input", () => {
    const query = nodeSearch.value.trim().toLowerCase();
    if (focusMap.hidden === false) { overview.hidden = false; focusMap.hidden = true; clearFocus.hidden = true; }
    const matches = Array.from(document.querySelectorAll<HTMLButtonElement>(".node-button")).filter((button) => {
      const match = !query || (button.dataset.search || "").includes(query);
      button.hidden = !match;
      return match;
    });
    document.querySelectorAll<HTMLDetailsElement>(".node-group").forEach((group) => {
      const hasMatch = Boolean(group.querySelector(".node-button:not([hidden])"));
      group.hidden = !hasMatch;
      if (hasMatch && query) group.open = true;
    });
    nodeEmpty.hidden = matches.length !== 0;
    setTestState("explore", matches.length, 0, matches.length);
    setText(status, matches.length ? `${matches.length} nodes match “${nodeSearch.value.trim()}”.` : `No nodes match “${nodeSearch.value.trim()}”.`);
    if (query && matches.length === 1) showFocusedNode(matches[0].dataset.nodeId || "");
  });

  const relationshipSearch = document.querySelector<HTMLInputElement>("#relationship-search")!;
  const relationshipStatus = document.querySelector<HTMLSelectElement>("#relationship-status")!;
  const relationshipCount = document.querySelector<HTMLElement>("#relationship-count")!;
  const relationshipEmpty = document.querySelector<HTMLElement>("#relationship-empty")!;
  const relationshipRows = Array.from(document.querySelectorAll<HTMLButtonElement>(".relationship-row"));
  const filterRelationships = () => {
    const query = relationshipSearch.value.trim().toLowerCase();
    const selectedStatus = relationshipStatus.value;
    let visible = 0;
    relationshipRows.forEach((row) => {
      const matches = (!query || (row.dataset.search || "").includes(query)) && (selectedStatus === "all" || row.dataset.status === selectedStatus);
      row.hidden = !matches;
      if (matches) visible += 1;
    });
    setText(relationshipCount, `${visible} relationship${visible === 1 ? "" : "s"}`);
    relationshipEmpty.hidden = visible !== 0;
    setText(status, visible ? `${visible} relationships match the current filters.` : "No relationships match the current filters.");
  };
  relationshipSearch.addEventListener("input", filterRelationships);
  relationshipStatus.addEventListener("change", filterRelationships);
  relationshipRows.forEach((row) => row.addEventListener("click", () => renderRelationship(row.dataset.relationshipId || "")));
  evidenceButton.addEventListener("click", () => window.dispatchEvent(new CustomEvent("hxg:view-evidence", { detail: { claimIds: activeClaimIds } })));
  renderRelationship(data.graph.guided_pathways[0].relationship_id);
</script>

<style is:global>
  .graph-section { max-width: var(--max); margin: 0 auto; padding: 100px var(--page-gutter) 120px; }
  .graph-heading { display: grid; grid-template-columns: 1.15fr .85fr; gap: 72px; align-items: end; margin-bottom: 44px; }
  .graph-heading h2 { margin: 0; max-width: 920px; font-size: clamp(2.4rem,5vw,5.2rem); line-height: .98; letter-spacing: -.06em; }
  .graph-heading > p { margin: 0; color: var(--muted); line-height: 1.65; }
  .graph-explorer { border: 1px solid var(--line); background: #081a28; }
  .graph-explorer [hidden] { display: none !important; }
  .mode-tabs { display: flex; border-bottom: 1px solid var(--line); background: #071827; }
  .mode-tabs button { min-height: 56px; padding: 0 24px; border: 0; border-right: 1px solid var(--line); background: transparent; color: var(--muted); font-size: .92rem; font-weight: 720; cursor: pointer; }
  .mode-tabs button[aria-selected="true"] { background: var(--ink); color: var(--canvas); }
  .explorer-grid { display: grid; grid-template-columns: minmax(0,1fr) 340px; min-height: 760px; }
  .explorer-main { min-width: 0; display: flex; flex-direction: column; border-right: 1px solid var(--line); }
  .mode-panel { flex: 1; min-width: 0; padding: 26px; }
  .mode-panel[hidden] { display: none; }
  .pathway-legend { display: grid; grid-template-columns: minmax(0,1fr) 180px minmax(0,1fr); gap: 18px; padding: 0 18px 12px; color: var(--faint); font-size: .7rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .pathway-legend span:nth-child(2) { text-align: center; }
  .pathway-list { display: grid; border-top: 1px solid var(--line); }
  .pathway-row { --pathway-color: var(--cyan); width: 100%; min-height: 104px; display: grid; grid-template-columns: minmax(0,1fr) 180px minmax(0,1fr); gap: 18px; align-items: stretch; padding: 10px 0; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--ink); text-align: left; cursor: pointer; }
  .pathway-row:hover, .pathway-row.is-selected { background: rgba(76,196,217,.055); }
