---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#061522" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href={`${baseUrl}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to evidence</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --ink: #f7f3ea;
    --muted: #9eb0bc;
    --faint: #6f8492;
    --canvas: #061522;
    --surface: #0a1d2c;
    --surface-strong: #10283a;
    --line: #244156;
    --cyan: #4cc4d9;
    --blue: #4baeff;
    --green: #79d35c;
    --amber: #f5bc31;
    --violet: #aa87ee;
    --orange: #f28e37;
    --red: #ff786c;
    --max: 1440px;
    --page-gutter: clamp(18px, 4vw, 56px);
    --header-height: 74px;
    --header-offset: calc(var(--header-height) + 22px);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-synthesis: none;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--canvas); scroll-padding-top: var(--header-offset); }
  body { margin: 0; min-width: 0; background: var(--canvas); color: var(--ink); }
  button, input, select { font: inherit; }
  button, a { -webkit-tap-highlight-color: transparent; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--amber); outline-offset: 3px; }
  .skip-link { position: fixed; z-index: 100; top: 8px; left: 8px; min-height: 44px; display: inline-flex; align-items: center; transform: translateY(-150%); background: var(--ink); color: var(--canvas); padding: 10px 14px; }
  .skip-link:focus { transform: translateY(0); }
  .eyebrow { margin: 0 0 12px; color: var(--cyan); font-size: .76rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  main [id] { scroll-margin-top: var(--header-offset); }
  @media (max-width: 620px) { :root { --header-height: 66px; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>
